generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

enum SongStatus {
  WANT_TO_LEARN
  LEARNING
  PRACTICING 
  LEARNT
}

model Song {
  id Int @id @default(autoincrement())
  name String
  band Band? @relation(fields:[bandId], references: [id])   
  bandId Int?
  album String
  description String?
  tuning Tuning? @relation(fields:[tuningId], references:[id])
  tuningId Int?
  status SongStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Band{
  id Int @id @default(autoincrement())
  name String @unique
  songs Song[]
}

model Tuning{
  id Int @id @default(autoincrement())
  name String @unique
  songs Song[]
}
