generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

enum SongStatus {
  WANT_TO_LEARN
  LEARNING
  PRACTICING 
  LEARNT
}

model Song {
  id Int @id @default(autoincrement())
  name String
  band String   
  album String
  description String?
  tuning String
  status SongStatus
  createdAt DateTime @default(now())
}
